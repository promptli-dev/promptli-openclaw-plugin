{
  "name": "@promptli-npm/openclaw-plugin",
  "version": "0.1.1",
  "description": "Give your OpenClaw agent its own email address and phone number: email, SMS and phone calls as an OpenClaw channel over Promptli Comms Agent Link.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://comms.promptli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptli-dev/promptli-openclaw-plugin.git"
  },
  "keywords": ["openclaw", "openclaw-plugin", "channel", "email", "sms", "phone", "voice", "agents", "promptli"],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "dist",
    "skills",
    "assets/icon.png",
    "assets/icon.svg",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@promptli-npm/sdk": "^0.1.3",
    "ws": "^8.23.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "openclaw": "2026.11.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "promptli",
      "label": "Promptli Comms",
      "selectionLabel": "Promptli Comms (email, SMS, phone)",
      "detailLabel": "Email, SMS and phone calls",
      "docsPath": "https://github.com/promptli-dev/promptli-openclaw-plugin#readme",
      "docsLabel": "promptli",
      "blurb": "Give the agent its own email address and phone number over Promptli Agent Link. No webhooks or tunnels.",
      "order": 90,
      "quickstartAllowFrom": true
    },
    "compat": {
      "pluginApi": ">=2026.11.5"
    },
    "build": {
      "openclawVersion": "2026.11.5"
    },
    "install": {
      "npmSpec": "@promptli-npm/openclaw-plugin",
      "clawhubSpec": "clawhub:@promptli-npm/openclaw-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.11.5"
    }
  }
}
